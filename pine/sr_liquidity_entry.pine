// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// Tendance H4 -> Zone S/R (H1) -> Liquidation (sweep LTF) -> Entrée (CHOCH LTF) dans le sens de la tendance
// Même logique que trade_analysis/strategy.py (version Python).
//
// Utilisation :
//   - Graphique 5m  + "Timeframe contexte" = 60  (H1 / 5m)
//   - Graphique 15m + "Timeframe contexte" = 240 (H4 / 15m)
//   - Symbole conseillé : COMEX:GC1! (or), NYMEX:CL1!, COMEX:SI1!...
//   - Résultats : onglet "Testeur de stratégie" + tableau en R en haut à droite.

//@version=6
strategy("S/R → Liquidation → Entrée", shorttitle = "SR-Liq", overlay = true,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5,
     slippage = 2, pyramiding = 0, margin_long = 5, margin_short = 5, max_boxes_count = 300, max_lines_count = 300,
     max_labels_count = 300)

// ───────────────────────────── Paramètres ─────────────────────────────
grpCtx = "1. Tendance et zones S/R (top-down)"
trendTf      = input.timeframe("240", "Timeframe de la TENDANCE", group = grpCtx, tooltip = "Décide du sens : on n'achète qu'en tendance haussière, on ne vend qu'en tendance baissière. 240 = H4.")
htfTf        = input.timeframe("60", "Timeframe des ZONES S/R", group = grpCtx, tooltip = "Où chercher les supports / résistances et les liquidations. 60 = H1. Graphique (entrée) : 15m ou 5m.")
htfL         = input.int(5, "Pivot HTF : bougies à gauche", minval = 1, group = grpCtx)
htfR         = input.int(5, "Pivot HTF : bougies à droite", minval = 1, group = grpCtx)
zoneMergeAtr = input.float(0.35, "Fusion des pivots (× ATR HTF)", step = 0.05, group = grpCtx)
zoneMaxWAtr  = input.float(1.0, "Largeur max d'une zone (× ATR HTF)", step = 0.1, group = grpCtx)
minTouches   = input.int(2, "Contacts minimum", minval = 1, group = grpCtx)
zoneMaxAge   = input.int(300, "Âge max d'une zone (bougies HTF)", minval = 1, group = grpCtx)

grpSw = "2. Liquidation (sweep)"
sweepMinAtr  = input.float(0.2, "Dépassement min (× ATR LTF)", step = 0.05, group = grpSw)
sweepMaxAtr  = input.float(1.0, "Dépassement max (× ATR HTF)", step = 0.1, group = grpSw, tooltip = "Au-delà : vraie cassure, pas une liquidation")

grpEn = "3. Entrée (CHOCH LTF)"
ltfL         = input.int(3, "Pivot LTF : bougies à gauche", minval = 1, group = grpEn)
ltfR         = input.int(2, "Pivot LTF : bougies à droite", minval = 1, group = grpEn)
confirmBars  = input.int(12, "Bougies max pour confirmer", minval = 1, group = grpEn)

grpRk = "4. Risque"
slBufAtr     = input.float(0.2, "Marge du stop (× ATR LTF)", step = 0.05, group = grpRk)
stopMode     = input.string("Mèche de liquidation", "Stop loss", options = ["Structure H4", "Mèche de liquidation"], group = grpRk, tooltip = "• Structure H4 : sous le dernier creux H4 (achat) / au-dessus du dernier sommet H4 (vente). Si la mèche de liquidation est plus loin, c'est elle qui est utilisée.\n• Mèche de liquidation : juste derrière la mèche du sweep (stop plus court).")
tpMode       = input.string("Order block opposé", "Objectif (take profit)", options = ["Order block opposé", "Liquidité H4", "R:R fixe"], group = grpRk, tooltip = "• Order block opposé : le bord du prochain order block non mitigé dans le sens du trade (un OB vendeur au-dessus pour un achat, un OB acheteur en dessous pour une vente). Sans OB, l'objectif R:R fixe est utilisé.\n• Liquidité H4 : le plus haut H4 récent (achat) / le plus bas H4 récent (vente), là où reposent les stops (BSL / SSL).\n• R:R fixe : objectif = R:R × risque.")
tpLook       = input.int(20, "Liquidité H4 : bougies H4 regardées", minval = 3, group = grpRk)
minRR        = input.float(1.0, "R:R minimum (sinon pas de trade)", step = 0.25, group = grpRk)
obTf         = input.timeframe("60", "Timeframe des order blocks (objectif)", group = grpRk, tooltip = "60 = OB H1 (objectifs proches, trades de quelques minutes à quelques heures). 240 = OB H4 (objectifs plus loin).")
rr           = input.float(2.0, "R:R fixe (si choisi)", step = 0.25, group = grpRk)
maxRiskAtr   = input.float(1.5, "Stop max (× ATR du timeframe du stop)", step = 0.1, group = grpRk)
maxHold      = input.int(288, "Durée max en position (bougies)", minval = 1, group = grpRk)

grpI = "4b. Intraday (pas de position la nuit)"
intraday     = input.bool(true, "Mode intraday", group = grpI, tooltip = "Aucune position gardée après l'heure de clôture. La pause CME de l'or est à 22:00 UTC en hiver et 21:00 UTC en été.")
entryStartH  = input.int(7, "Première entrée à (heure UTC)", minval = 0, maxval = 23, group = grpI)
entryEndH    = input.int(19, "Plus d'entrée à partir de (heure UTC)", minval = 0, maxval = 24, group = grpI)
flatH        = input.int(20, "Clôture forcée : heure UTC", minval = 0, maxval = 23, group = grpI)
flatM        = input.int(45, "Clôture forcée : minute", minval = 0, maxval = 59, group = grpI)
maxTradesDay = input.int(3, "Trades max par jour", minval = 1, group = grpI)
maxLossDayR  = input.float(2.0, "Stop journalier (perte max en R)", step = 0.5, group = grpI, tooltip = "Plus d'entrée ce jour-là une fois cette perte atteinte.")

grpF = "5. Fondamental & filtres"
biasStr      = input.text_area("", "Biais fondamental", group = grpF, tooltip = "Format date:sens séparés par ; (ordre chronologique).\nEx : 2026-01-12:long;2026-01-26:short;2026-02-09:neutral\nSens : long, short, neutral, off. Vide = neutre partout. Avant la 1re date = off.")
neutralBoth  = input.bool(true, "Biais neutre = les deux sens autorisés", group = grpF)
dirMode      = input.string("Les deux", "Sens autorisés", options = ["Les deux", "Long seulement", "Short seulement"], group = grpF)
trendMode    = input.string("Structure (BOS / CHOCH)", "Tendance du timeframe contexte (H4)", options = ["Structure (BOS / CHOCH)", "Structure stricte (HH+HL / LH+LL)", "Moyenne mobile", "Désactivée"], group = grpF, tooltip = "On ne trade QUE dans le sens de la tendance H4.\n• Structure (BOS / CHOCH) : haussière dès qu'une bougie H4 clôture au-dessus du dernier sommet, baissière dès qu'elle clôture sous le dernier creux.\n• Stricte : haussière seulement si les 2 derniers sommets ET creux montent (HH + HL), baissière s'ils descendent (LH + LL), sinon range = pas de trade.\n• Moyenne mobile : au-dessus = haussière, en dessous = baissière.")
trendLen     = input.int(50, "Longueur de la moyenne mobile (si choisie)", minval = 5, group = grpF)
newsStr      = input.text_area("", "Annonces fort impact (heure UTC)", group = grpF, tooltip = "Une par ligne ou séparées par ;\nEx : 2026-01-13 13:30\nSur investing.com, règle le fuseau sur GMT.")
newsBefore   = input.int(30, "Minutes bloquées avant annonce", minval = 0, group = grpF)
newsAfter    = input.int(30, "Minutes bloquées après annonce", minval = 0, group = grpF)
sAsia        = input.bool(true, "Asie (00-07 UTC)", group = grpF)
sLondon      = input.bool(true, "Londres (07-12)", group = grpF)
sOverlap     = input.bool(true, "Overlap Londres/NY (12-16)", group = grpF)
sNy          = input.bool(true, "New York (16-21)", group = grpF)
sClose       = input.bool(true, "Fermeture (21-24)", group = grpF)

grpV = "6. Affichage"
showZones    = input.bool(true, "Afficher les zones", group = grpV)
showLevels   = input.bool(true, "Afficher stop / objectif", group = grpV)
showFunnel   = input.bool(true, "Afficher le diagnostic", group = grpV)
showTrendBg  = input.bool(true, "Colorer le fond selon la tendance H4", group = grpV)
showStruct   = input.bool(true, "Structure H4 : HH / HL / LH / LL, BOS / CHOCH", group = grpV)
showLiq      = input.bool(true, "Zones de liquidité (BSL / SSL et liquidités prises)", group = grpV)
showMitig    = input.bool(true, "Zones de mitigation (order block avant l'entrée)", group = grpV)
showOB       = input.bool(true, "Order blocks non mitigés (objectifs)", group = grpV)
mitigBars    = input.int(30, "Longueur d'une zone de mitigation (bougies)", minval = 5, group = grpV)
atrLen       = 14

if timeframe.in_seconds() >= timeframe.in_seconds(htfTf) or timeframe.in_seconds(htfTf) > timeframe.in_seconds(trendTf)
    runtime.error("Ordre des timeframes attendu : graphique (entrée) < zones S/R <= tendance. Ex : graphique 15m, zones 60, tendance 240.")

// ───────────────────────────── Outils ─────────────────────────────
// Swing high : high > les L bougies avant ET >= les R bougies après.
// La valeur n'apparaît qu'à la clôture de la R-ième bougie après (pas de look-ahead).
f_ph(int L, int R) =>
    hBefore = ta.highest(high, L)
    hAfter  = ta.highest(high, R)
    c = high[R]
    c > hBefore[R + 1] and c >= hAfter ? c : na

f_pl(int L, int R) =>
    lBefore = ta.lowest(low, L)
    lAfter  = ta.lowest(low, R)
    c = low[R]
    c < lBefore[R + 1] and c <= lAfter ? c : na

f_ts(string d, string t) =>
    dp = str.split(d, "-")
    tp = str.split(t, ":")
    int res = na
    if dp.size() == 3
        h  = tp.size() >= 2 ? int(str.tonumber(tp.get(0))) : 0
        mi = tp.size() >= 2 ? int(str.tonumber(tp.get(1))) : 0
        res := timestamp("UTC", int(str.tonumber(dp.get(0))), int(str.tonumber(dp.get(1))), int(str.tonumber(dp.get(2))), h, mi)
    res

// ───────────────────────────── Données HTF (bougies clôturées seulement) ─────────────────────────────
f_htf() =>
    ph = f_ph(htfL, htfR)
    pl = f_pl(htfL, htfR)
    a  = ta.atr(atrLen)
    e  = ta.ema(close, trendLen)
    // Structure de marché H4 (jours 3, 5 et 7 des notes)
    var float lastH = na
    var float prevH = na
    var float lastL = na
    var float prevL = na
    var int   trBos = 0
    var int   lastHT = na
    var int   lastLT = na
    var bool  hBroken = false
    var bool  lBroken = false
    if not na(ph)
        prevH   := lastH
        lastH   := ph
        lastHT  := time[htfR]
        hBroken := false
    if not na(pl)
        prevL   := lastL
        lastL   := pl
        lastLT  := time[htfR]
        lBroken := false
    upBreak = not na(lastH) and close > lastH
    dnBreak = not na(lastL) and close < lastL
    // Événement à dessiner : 1 = BOS haussier, 2 = CHOCH haussier, -1 = BOS baissier, -2 = CHOCH baissier
    int   evt    = 0
    float evtLvl = na
    int   evtT   = na
    if upBreak and (trBos != 1 or not hBroken)
        evt     := trBos == 1 ? 1 : 2
        evtLvl  := lastH
        evtT    := lastHT
        hBroken := true
    if dnBreak and (trBos != -1 or not lBroken)
        evt     := trBos == -1 ? -1 : -2
        evtLvl  := lastL
        evtT    := lastLT
        lBroken := true
    if upBreak
        trBos := 1
    if dnBreak
        trBos := -1
    trStrict = na(prevH) or na(prevL) ? 0 : lastH > prevH and lastL > prevL ? 1 : lastH < prevH and lastL < prevL ? -1 : 0
    hh = ta.highest(high, tpLook)
    ll = ta.lowest(low, tpLook)
    [ph[1], pl[1], time[htfR + 1], a[1], time[1], e[1], trBos[1], trStrict[1], evt[1], evtLvl[1], evtT[1], lastH[1], lastL[1], hh[1], ll[1]]

[hPH, hPL, hPivT, hATR, hBarT, hEma0, hTrBos0, hTrStrict0, hEvt0, hEvtLvl0, hEvtT0, hLastH0, hLastL0, hHH0, hLL0] = request.security(syminfo.tickerid, htfTf, f_htf(), lookahead = barmerge.lookahead_on)
// Tendance et structure sur le timeframe de tendance (H4)
[tPH, tPL, tPivT, tATR, tBarT, hEma, hTrBos, hTrStrict, hEvt, hEvtLvl, hEvtT, tLastH, tLastL, tHH, tLL] = request.security(syminfo.tickerid, trendTf, f_htf(), lookahead = barmerge.lookahead_on)
newTrendBar = not na(tBarT) and (na(tBarT[1]) or tBarT != tBarT[1])

// ───────────────────────────── Order blocks (objectifs) ─────────────────────────────
// OB acheteur : dernière bougie baissière avant une bougie haussière qui clôture au-dessus de son plus haut.
// OB vendeur  : dernière bougie haussière avant une bougie baissière qui clôture sous son plus bas.
f_ob() =>
    bullOB = close[1] < open[1] and close > high[1]
    bearOB = close[1] > open[1] and close < low[1]
    obH = high[1]
    obL = low[1]
    [bullOB[1], bearOB[1], obH[1], obL[1], time[2], time[1]]

[obBull, obBear, obTop, obBot, obTime, obBarT] = request.security(syminfo.tickerid, obTf, f_ob(), lookahead = barmerge.lookahead_on)
newObBar = not na(obBarT) and (na(obBarT[1]) or obBarT != obBarT[1])

var array<float> obT = array.new<float>()
var array<float> obB = array.new<float>()
var array<int>   obD = array.new<int>()     // 1 = OB acheteur (sous le prix), -1 = OB vendeur (au-dessus)
var array<int>   obX = array.new<int>()     // heure de la bougie OB
if newObBar
    if obBull
        obT.push(obTop)
        obB.push(obBot)
        obD.push(1)
        obX.push(obTime)
    if obBear
        obT.push(obTop)
        obB.push(obBot)
        obD.push(-1)
        obX.push(obTime)
    while obT.size() > 60
        obT.shift()
        obB.shift()
        obD.shift()
        obX.shift()
// Un OB est mitigé (consommé) dès que le prix le touche
if obT.size() > 0
    for i = obT.size() - 1 to 0
        if (obD.get(i) == -1 and high >= obB.get(i)) or (obD.get(i) == 1 and low <= obT.get(i))
            obT.remove(i)
            obB.remove(i)
            obD.remove(i)
            obX.remove(i)

// Prochain OB opposé : vendeur au-dessus du prix (achat) / acheteur en dessous (vente)
f_nextOB(int dir, float px) =>
    float best = na
    if obT.size() > 0
        for i = 0 to obT.size() - 1
            if dir == 1 and obD.get(i) == -1 and obB.get(i) > px
                best := na(best) ? obB.get(i) : math.min(best, obB.get(i))
            if dir == -1 and obD.get(i) == 1 and obT.get(i) < px
                best := na(best) ? obT.get(i) : math.max(best, obT.get(i))
    best
newHtf = not na(hBarT) and (na(hBarT[1]) or hBarT != hBarT[1])

// ───────────────────────────── Biais & annonces ─────────────────────────────
var array<int>    biasT = array.new<int>()
var array<string> biasV = array.new<string>()
var array<int>    newsT = array.new<int>()

if barstate.isfirst
    for it in str.split(str.replace_all(str.replace_all(biasStr, "\n", ";"), " ", ""), ";")
        kv = str.split(it, ":")
        if kv.size() == 2
            t = f_ts(kv.get(0), "")
            if not na(t)
                biasT.push(t)
                biasV.push(str.lower(kv.get(1)))
    for it in str.split(str.replace_all(newsStr, "\n", ";"), ";")
        string d  = ""
        string tm = ""
        for x in str.split(it, " ")
            if x != ""
                if d == ""
                    d := x
                else if tm == ""
                    tm := x
        if d != ""
            t = f_ts(d, tm)
            if not na(t)
                newsT.push(t)

f_bias(int t) =>
    string b = biasT.size() == 0 ? "neutral" : "off"
    if biasT.size() > 0
        for i = 0 to biasT.size() - 1
            if biasT.get(i) <= t
                b := biasV.get(i)
    b

f_biasAllows(int t, int dir) =>
    b = f_bias(t)
    b == "neutral" ? neutralBoth : (b == "long" and dir == 1) or (b == "short" and dir == -1)

f_newsBlocked(int t) =>
    bool blk = false
    for nt in newsT
        if t >= nt - newsBefore * 60000 and t <= nt + newsAfter * 60000
            blk := true
    blk

f_session(int t) =>
    h = hour(t, "UTC")
    h < 7 ? "asie" : h < 12 ? "londres" : h < 16 ? "overlap_londres_ny" : h < 21 ? "new_york" : "fermeture"

f_sessOk(int t) =>
    h = hour(t, "UTC")
    h < 7 ? sAsia : h < 12 ? sLondon : h < 16 ? sOverlap : h < 21 ? sNy : sClose

// ───────────────────────────── Zones S/R ─────────────────────────────
var array<float> zLow   = array.new<float>()
var array<float> zHigh  = array.new<float>()
var array<int>   zTouch = array.new<int>()
var array<int>   zLast  = array.new<int>()
var array<int>   zKind  = array.new<int>()   // 1 = pivots hauts, 2 = pivots bas, 3 = les deux

f_addZone(float p, int kind, int pt, float tol, float maxW) =>
    int   best  = -1
    float bestD = na
    n = zLow.size()
    if n > 0
        for i = 0 to n - 1
            lo = zLow.get(i)
            hi = zHigh.get(i)
            if p >= lo - tol and p <= hi + tol
                d = math.abs(p - (lo + hi) / 2)
                if best == -1 or d < bestD
                    best  := i
                    bestD := d
    if best >= 0
        nl = math.min(zLow.get(best), p)
        nh = math.max(zHigh.get(best), p)
        if nh - nl <= maxW
            zLow.set(best, nl)
            zHigh.set(best, nh)
        zTouch.set(best, zTouch.get(best) + 1)
        zLast.set(best, math.max(zLast.get(best), pt))
        zKind.set(best, zKind.get(best) == kind ? kind : 3)
    else
        zLow.push(p)
        zHigh.push(p)
        zTouch.push(1)
        zLast.push(pt)
        zKind.push(kind)
        if zLow.size() > 80
            zLow.shift()
            zHigh.shift()
            zTouch.shift()
            zLast.shift()
            zKind.shift()
    best

if newHtf and not na(hATR)
    tol  = zoneMergeAtr * hATR
    maxW = zoneMaxWAtr * hATR
    if not na(hPH)
        f_addZone(hPH, 1, hPivT, tol, maxW)
    if not na(hPL)
        f_addZone(hPL, 2, hPivT, tol, maxW)

nowT     = time_close
htfDurMs = timeframe.in_seconds(htfTf) * 1000
if zLow.size() > 0
    for i = zLow.size() - 1 to 0
        if nowT - zLast.get(i) > zoneMaxAge * htfDurMs
            zLow.remove(i)
            zHigh.remove(i)
            zTouch.remove(i)
            zLast.remove(i)
            zKind.remove(i)

// ───────────────────────────── Structure LTF ─────────────────────────────
ltfATR = ta.atr(atrLen)
lph = f_ph(ltfL, ltfR)
lpl = f_pl(ltfL, ltfR)
var float lastHigh = na
var float lastLow  = na
if not na(lph)
    lastHigh := lph
if not na(lpl)
    lastLow := lpl

// ───────────────────────────── Machine à états ─────────────────────────────
var int   pDir  = 0      // 1 = sweep haussier en attente, -1 = baissier
var float pExt  = na
var float pTrig = na
var int   pBar  = na
var float pZLo  = na
var float pZHi  = na
var int   pZT   = 0

bool  sigLong   = false
bool  sigShort  = false
bool  sweepL    = false
bool  sweepS    = false
bool  confirmed = false
float sigStop   = na
float sigTarget = na

ready     = not na(hATR) and not na(ltfATR) and bar_index > 0

// Tendance H4 en vigueur : 1 = haussière, -1 = baissière, 0 = range / inconnue
htfTrend = switch trendMode
    "Structure (BOS / CHOCH)"            => nz(hTrBos)
    "Structure stricte (HH+HL / LH+LL)"  => nz(hTrStrict)
    "Moyenne mobile"                     => na(hEma) ? 0 : close > hEma ? 1 : -1
    => 0
allowLong  = (trendMode == "Désactivée" or htfTrend == 1) and dirMode != "Short seulement"
allowShort = (trendMode == "Désactivée" or htfTrend == -1) and dirMode != "Long seulement"
prevClose = close[1]

// Entonnoir de diagnostic : où les signaux sont-ils perdus ?
var int cSweep   = 0
var int cExpired = 0
var int cInval   = 0
var int cConfirm = 0
var int cBias    = 0
var int cNews    = 0
var int cSess    = 0
var int cRisk    = 0
var int cBusy    = 0
var int cSignal  = 0
var int cDay     = 0
var int cDir     = 0

// Journée de trading (UTC) : compteurs remis à zéro chaque jour
dayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
var int   tradesToday = 0
var float dayR        = 0.0
if dayKey != dayKey[1]
    tradesToday := 0
    dayR        := 0.0
minOfDay = hour(nowT, "UTC") * 60 + minute(nowT, "UTC")
inEntryWindow = minOfDay >= entryStartH * 60 and minOfDay < entryEndH * 60
okDay = not intraday or (inEntryWindow and tradesToday < maxTradesDay and dayR > -maxLossDayR)

// Dernière bougie opposée depuis la liquidation (zone de mitigation), suivie sans remonter l'historique
var float obHi  = na
var float obLo  = na
var int   obBar = na
if pDir != 0 and ((pDir == 1 and close < open) or (pDir == -1 and close > open))
    obHi  := high
    obLo  := low
    obBar := bar_index

// 1) Confirmation d'un sweep en attente
if ready and pDir != 0
    if bar_index - pBar > confirmBars
        pDir := 0
        cExpired += 1
    else if (pDir == 1 and low < pExt) or (pDir == -1 and high > pExt)
        pDir := 0
        cInval += 1
    else if (pDir == 1 and close > pTrig) or (pDir == -1 and close < pTrig)
        stpSweep = pDir == 1 ? pExt - slBufAtr * ltfATR : pExt + slBufAtr * ltfATR
        stpH4    = pDir == 1 ? tLastL - slBufAtr * ltfATR : tLastH + slBufAtr * ltfATR
        useH4Stp = stopMode == "Structure H4" and not na(stpH4) and (pDir == 1 ? stpH4 < stpSweep : stpH4 > stpSweep)
        stp  = useH4Stp ? stpH4 : stpSweep
        risk = pDir == 1 ? close - stp : stp - close
        riskCap = (stopMode == "Structure H4" ? maxRiskAtr * nz(tATR, hATR) : maxRiskAtr * hATR)
        tgtH4   = pDir == 1 ? tHH : tLL
        tgtRR   = pDir == 1 ? close + rr * risk : close - rr * risk
        tgtOB   = f_nextOB(pDir, close)
        tgt     = tpMode == "Liquidité H4" ? tgtH4 : tpMode == "Order block opposé" ? nz(tgtOB, tgtRR) : tgtRR
        rrReal  = risk > 0 and not na(tgt) ? (pDir == 1 ? tgt - close : close - tgt) / risk : 0.0
        okBias = f_biasAllows(nowT, pDir)
        okNews = not f_newsBlocked(nowT)
        okSess = f_sessOk(nowT)
        okRisk = risk > 0 and risk <= riskCap and rrReal >= (tpMode == "R:R fixe" ? 0.0 : minRR)
        cConfirm += 1
        cBias += okBias ? 0 : 1
        cNews += okBias and not okNews ? 1 : 0
        cSess += okBias and okNews and not okSess ? 1 : 0
        cRisk += okBias and okNews and okSess and not okRisk ? 1 : 0
        cDay  += okBias and okNews and okSess and okRisk and not okDay ? 1 : 0
        okMode  = dirMode == "Les deux" or (dirMode == "Long seulement" and pDir == 1) or (dirMode == "Short seulement" and pDir == -1)
        okTrend = trendMode == "Désactivée" or htfTrend == pDir
        okDir   = okMode and okTrend
        cDir  += okBias and okNews and okSess and okRisk and okDay and not okDir ? 1 : 0
        if okBias and okNews and okSess and okRisk and okDay and okDir
            cSignal += 1
            sigStop   := stp
            sigTarget := tgt
            sigLong   := pDir == 1
            sigShort  := pDir == -1
            // Zone de mitigation : dernière bougie opposée avant l'impulsion (order block)
            if showMitig and not na(obBar)
                mCol = pDir == 1 ? color.new(color.teal, 0) : color.new(color.maroon, 0)
                box.new(obBar, obHi, bar_index + mitigBars, obLo, border_color = color.new(mCol, 30),
                         bgcolor = color.new(mCol, 82), border_style = line.style_dotted,
                         text = "Mitigation", text_size = size.tiny, text_color = mCol, text_halign = text.align_right)
        pDir      := 0
        confirmed := true

// 2) Détection d'une nouvelle liquidation
if ready and pDir == 0 and not confirmed and zLow.size() > 0
    int bestT = -1
    for i = 0 to zLow.size() - 1
        t = zTouch.get(i)
        if t >= minTouches
            lo = zLow.get(i)
            hi = zHigh.get(i)
            penL = lo - low
            if allowLong and prevClose > lo and penL >= sweepMinAtr * ltfATR and penL <= sweepMaxAtr * hATR and close > lo and not na(lastHigh) and lastHigh > close
                if bestT == -1 or t > bestT
                    pDir  := 1
                    pExt  := low
                    pTrig := lastHigh
                    pBar  := bar_index
                    pZLo  := lo
                    pZHi  := hi
                    pZT   := t
                    bestT := t
            penH = high - hi
            if allowShort and prevClose < hi and penH >= sweepMinAtr * ltfATR and penH <= sweepMaxAtr * hATR and close < hi and not na(lastLow) and lastLow < close
                if bestT == -1 or t > bestT
                    pDir  := -1
                    pExt  := high
                    pTrig := lastLow
                    pBar  := bar_index
                    pZLo  := lo
                    pZHi  := hi
                    pZT   := t
                    bestT := t
    sweepL := pDir == 1
    sweepS := pDir == -1
    cSweep += pDir != 0 ? 1 : 0
    if pDir != 0
        isOpp = (pDir == 1 and close < open) or (pDir == -1 and close > open)
        obHi  := isOpp ? high : na
        obLo  := isOpp ? low : na
        obBar := isOpp ? bar_index : na
    // Liquidité prise : de la limite de la zone jusqu'à la mèche
    if showLiq and pDir != 0
        lCol = pDir == 1 ? color.new(color.aqua, 0) : color.new(color.fuchsia, 0)
        edge = pDir == 1 ? pZLo : pZHi
        box.new(bar_index - 2, math.max(edge, pExt), bar_index + 2, math.min(edge, pExt), border_color = color.new(lCol, 20),
             bgcolor = color.new(lCol, 75), text = pDir == 1 ? "SSL prise" : "BSL prise", text_size = size.tiny,
             text_color = lCol, text_valign = pDir == 1 ? text.align_bottom : text.align_top)

if (sigLong or sigShort) and strategy.position_size != 0
    cBusy += 1

// ───────────────────────────── Ordres ─────────────────────────────
// Entrée au marché à l'ouverture de la bougie suivante, un seul trade à la fois.

if (sigLong or sigShort) and strategy.position_size == 0
    if sigLong
        strategy.entry("Long", strategy.long, comment = "SL " + str.tostring(sigStop, format.mintick))
        strategy.exit("Sortie L", "Long", stop = sigStop, limit = sigTarget, comment_loss = "SL", comment_profit = "TP")
    else
        strategy.entry("Short", strategy.short, comment = "SL " + str.tostring(sigStop, format.mintick))
        strategy.exit("Sortie S", "Short", stop = sigStop, limit = sigTarget, comment_loss = "SL", comment_profit = "TP")
    tradesToday += 1
    dirTxt = sigLong ? "long" : "short"
    msg = '{"symbol":"' + syminfo.ticker + '","direction":"' + dirTxt + '","entry":' + str.tostring(close, format.mintick) +
         ',"stop":' + str.tostring(sigStop, format.mintick) + ',"target":' + str.tostring(sigTarget, format.mintick) +
         ',"rr":' + str.tostring((math.abs(sigTarget - close)) / math.abs(close - sigStop), "0.00") + ',"zone":"' + str.tostring(pZLo, format.mintick) + '-' + str.tostring(pZHi, format.mintick) +
         '","contacts":' + str.tostring(pZT) + ',"sweep":' + str.tostring(pExt, format.mintick) +
         ',"bias":"' + f_bias(nowT) + '","session":"' + f_session(nowT) + '","tf":"' + timeframe.period + '/' + htfTf + '/' + trendTf + '"}'
    alert(msg, alert.freq_once_per_bar_close)

if strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
    strategy.close_all(comment = "Timeout")

// Intraday : tout fermer à l'heure de clôture (ou si une position a passé la nuit)
pastFlat = minOfDay >= flatH * 60 + flatM or minOfDay < entryStartH * 60
if intraday and strategy.position_size != 0 and pastFlat
    strategy.close_all(comment = "Fin de journée")

// ───────────────────────────── Statistiques en R ─────────────────────────────
var float sumR    = 0.0
var int   nTrades = 0
var int   nWins   = 0
var float eqR     = 0.0
var float peakR   = 0.0
var float maxDD   = 0.0
var int   streak  = 0
var int   worstSt = 0
var int   seen    = 0
var int   nTP     = 0
var int   nSL     = 0
var int   nEOD    = 0
var int   nL      = 0
var int   nLW     = 0
var float rL      = 0.0
var int   nS      = 0
var int   nSW     = 0
var float rS      = 0.0
var float holdMin = 0.0

if strategy.closedtrades > seen
    for k = seen to strategy.closedtrades - 1
        stopK = str.tonumber(str.replace(strategy.closedtrades.entry_comment(k), "SL ", ""))
        if not na(stopK)
            rsk = math.abs(strategy.closedtrades.entry_price(k) - stopK) * syminfo.pointvalue * math.abs(strategy.closedtrades.size(k))
            if rsk > 0
                r = strategy.closedtrades.profit(k) / rsk
                dayR    += r
                ex = strategy.closedtrades.exit_comment(k)
                nTP     += ex == "TP" ? 1 : 0
                nSL     += ex == "SL" ? 1 : 0
                nEOD    += ex == "Fin de journée" or ex == "Timeout" ? 1 : 0
                holdMin += (strategy.closedtrades.exit_time(k) - strategy.closedtrades.entry_time(k)) / 60000.0
                nTrades += 1
                sumR    += r
                nWins   += r > 0 ? 1 : 0
                isLong   = strategy.closedtrades.size(k) > 0
                nL      += isLong ? 1 : 0
                nLW     += isLong and r > 0 ? 1 : 0
                rL      += isLong ? r : 0.0
                nS      += isLong ? 0 : 1
                nSW     += not isLong and r > 0 ? 1 : 0
                rS      += isLong ? 0.0 : r
                eqR     += r
                peakR   := math.max(peakR, eqR)
                maxDD   := math.min(maxDD, eqR - peakR)
                streak  := r <= 0 ? streak + 1 : 0
                worstSt := math.max(worstSt, streak)
    seen := strategy.closedtrades

var table tb = table.new(position.top_right, 2, 25, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    txt = color.white
    table.cell(tb, 0, 0, "Trades", text_color = txt)
    table.cell(tb, 1, 0, str.tostring(nTrades), text_color = nTrades < 100 ? color.orange : txt)
    table.cell(tb, 0, 1, "Réussite", text_color = txt)
    table.cell(tb, 1, 1, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "0.0") + " %" : "-", text_color = txt)
    table.cell(tb, 0, 2, "Espérance", text_color = txt)
    table.cell(tb, 1, 2, nTrades > 0 ? str.tostring(sumR / nTrades, "0.00") + " R" : "-", text_color = nTrades > 0 and sumR > 0 ? color.lime : color.red)
    table.cell(tb, 0, 3, "Total", text_color = txt)
    table.cell(tb, 1, 3, str.tostring(sumR, "0.0") + " R", text_color = txt)
    table.cell(tb, 0, 4, "Drawdown max", text_color = txt)
    table.cell(tb, 1, 4, str.tostring(maxDD, "0.0") + " R", text_color = txt)
    table.cell(tb, 0, 5, "Pire série", text_color = txt)
    table.cell(tb, 1, 5, str.tostring(worstSt) + " pertes", text_color = txt)
    table.cell(tb, 0, 6, nTrades < 100 ? "⚠ < 100 trades" : "Échantillon OK", text_color = nTrades < 100 ? color.orange : color.lime)
    table.merge_cells(tb, 0, 6, 1, 6)
    if showFunnel
        dim = color.new(color.white, 35)
        nActive = 0
        if zTouch.size() > 0
            for i = 0 to zTouch.size() - 1
                nActive += zTouch.get(i) >= minTouches ? 1 : 0
        table.cell(tb, 0, 7, "Diagnostic", text_color = color.yellow)
        table.merge_cells(tb, 0, 7, 1, 7)
        table.cell(tb, 0, 8, "Zones actives", text_color = dim)
        table.cell(tb, 1, 8, str.tostring(nActive) + " / " + str.tostring(zTouch.size()), text_color = dim)
        table.cell(tb, 0, 9, "Liquidations", text_color = dim)
        table.cell(tb, 1, 9, str.tostring(cSweep), text_color = dim)
        table.cell(tb, 0, 10, "– expirées", text_color = dim)
        table.cell(tb, 1, 10, str.tostring(cExpired), text_color = dim)
        table.cell(tb, 0, 11, "– invalidées", text_color = dim)
        table.cell(tb, 1, 11, str.tostring(cInval), text_color = dim)
        table.cell(tb, 0, 12, "CHOCH confirmés", text_color = dim)
        table.cell(tb, 1, 12, str.tostring(cConfirm), text_color = dim)
        table.cell(tb, 0, 13, "– bloqués biais", text_color = dim)
        table.cell(tb, 1, 13, str.tostring(cBias), text_color = dim)
        table.cell(tb, 0, 14, "– bloqués annonce", text_color = dim)
        table.cell(tb, 1, 14, str.tostring(cNews), text_color = dim)
        table.cell(tb, 0, 15, "– hors session", text_color = dim)
        table.cell(tb, 1, 15, str.tostring(cSess), text_color = dim)
        table.cell(tb, 0, 16, "– stop trop large / R:R trop faible", text_color = dim)
        table.cell(tb, 1, 16, str.tostring(cRisk), text_color = dim)
        table.cell(tb, 0, 17, "– hors horaires / limite jour", text_color = dim)
        table.cell(tb, 1, 17, str.tostring(cDay), text_color = dim)
        table.cell(tb, 0, 18, "Signaux (déjà en position)", text_color = dim)
        table.cell(tb, 1, 18, str.tostring(cSignal) + " (" + str.tostring(cBusy) + ")", text_color = dim)
        table.cell(tb, 0, 19, "Sorties TP / SL / fin jour", text_color = dim)
        table.cell(tb, 1, 19, str.tostring(nTP) + " / " + str.tostring(nSL) + " / " + str.tostring(nEOD), text_color = dim)
        table.cell(tb, 0, 20, "Durée moyenne", text_color = dim)
        table.cell(tb, 1, 20, nTrades > 0 ? str.tostring(holdMin / nTrades, "0") + " min" : "-", text_color = dim)
        table.cell(tb, 0, 21, "– bloqués sens / tendance", text_color = dim)
        table.cell(tb, 1, 21, str.tostring(cDir), text_color = dim)
    table.cell(tb, 0, 22, "Long : " + str.tostring(nL) + " trades", text_color = txt)
    table.cell(tb, 1, 22, nL > 0 ? str.tostring(100.0 * nLW / nL, "0") + " % · " + str.tostring(rL, "0.0") + " R" : "-", text_color = rL > 0 ? color.lime : color.red)
    table.cell(tb, 0, 23, "Short : " + str.tostring(nS) + " trades", text_color = txt)
    table.cell(tb, 1, 23, nS > 0 ? str.tostring(100.0 * nSW / nS, "0") + " % · " + str.tostring(rS, "0.0") + " R" : "-", text_color = rS > 0 ? color.lime : color.red)
    trTxt = htfTrend == 1 ? "HAUSSIÈRE" : htfTrend == -1 ? "BAISSIÈRE" : trendMode == "Désactivée" ? "filtre désactivé" : "RANGE"
    table.cell(tb, 0, 24, "Tendance " + trendTf + " actuelle", text_color = txt)
    table.cell(tb, 1, 24, trTxt, text_color = htfTrend == 1 ? color.lime : htfTrend == -1 ? color.red : color.gray)

// ───────────────────────────── Affichage ─────────────────────────────
bgcolor(showTrendBg and trendMode != "Désactivée" ? (htfTrend == 1 ? color.new(color.green, 93) : htfTrend == -1 ? color.new(color.red, 93) : na) : na, title = "Tendance H4")
plotshape(sweepL, "Liquidation haussière", shape.xcross, location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(sweepS, "Liquidation baissière", shape.xcross, location.abovebar, color.new(color.maroon, 0), size = size.tiny)
plotshape(sigLong, "Signal achat", shape.triangleup, location.belowbar, color.lime, size = size.small, text = "BUY")
plotshape(sigShort, "Signal vente", shape.triangledown, location.abovebar, color.red, size = size.small, text = "SELL")

if showLevels and (sigLong or sigShort)
    line.new(bar_index, sigStop, bar_index + 20, sigStop, color = color.red, style = line.style_dashed)
    line.new(bar_index, sigTarget, bar_index + 20, sigTarget, color = color.lime, style = line.style_dashed)

// Structure H4 : étiquettes HH / HL / LH / LL et cassures BOS / CHOCH
var float prevPH = na
var float prevPL = na
if newTrendBar and showStruct
    if not na(tPH)
        if not na(prevPH)
            isHH = tPH > prevPH
            label.new(tPivT, tPH, isHH ? "HH" : "LH", xloc = xloc.bar_time, style = label.style_label_down,
                 color = color.new(color.black, 100), textcolor = isHH ? color.lime : color.orange, size = size.small)
        prevPH := tPH
    if not na(tPL)
        if not na(prevPL)
            isHL = tPL > prevPL
            label.new(tPivT, tPL, isHL ? "HL" : "LL", xloc = xloc.bar_time, style = label.style_label_up,
                 color = color.new(color.black, 100), textcolor = isHL ? color.lime : color.orange, size = size.small)
        prevPL := tPL
    if nz(hEvt) != 0 and not na(hEvtLvl) and not na(hEvtT)
        evCol = hEvt > 0 ? color.lime : color.red
        line.new(hEvtT, hEvtLvl, tBarT, hEvtLvl, xloc = xloc.bar_time, color = evCol,
             style = math.abs(hEvt) == 2 ? line.style_solid : line.style_dashed, width = math.abs(hEvt) == 2 ? 2 : 1)
        label.new(tBarT, hEvtLvl, math.abs(hEvt) == 2 ? "CHOCH" : "BOS", xloc = xloc.bar_time,
             style = hEvt > 0 ? label.style_label_lower_left : label.style_label_upper_left,
             color = color.new(color.black, 100), textcolor = evCol, size = size.small)

var array<box>   zBoxes = array.new<box>()
var array<box>   obBoxes = array.new<box>()
if barstate.islast and showOB
    for b in obBoxes
        b.delete()
    obBoxes.clear()
    if obT.size() > 0
        for i = 0 to obT.size() - 1
            oc = obD.get(i) == 1 ? color.new(color.lime, 0) : color.new(color.orange, 0)
            obBoxes.push(box.new(obX.get(i), obT.get(i), time, obB.get(i), xloc = xloc.bar_time, extend = extend.right,
                 border_color = color.new(oc, 50), bgcolor = color.new(oc, 88), border_style = line.style_dashed,
                 text = obD.get(i) == 1 ? "OB acheteur" : "OB vendeur", text_size = size.tiny, text_color = oc,
                 text_halign = text.align_left))
var array<line>  lqLines = array.new<line>()
var array<label> lqLabels = array.new<label>()
if barstate.islast and showLiq
    for ln in lqLines
        ln.delete()
    lqLines.clear()
    for lb in lqLabels
        lb.delete()
    lqLabels.clear()
    if zLow.size() > 0
        for i = 0 to zLow.size() - 1
            if zTouch.get(i) >= minTouches
                lo = zLow.get(i)
                hi = zHigh.get(i)
                // Les stops reposent juste au-delà des zones : SSL sous les supports, BSL au-dessus des résistances
                if lo < close
                    lqLines.push(line.new(bar_index - 5, lo, bar_index + 15, lo, color = color.aqua, style = line.style_dotted))
                    lqLabels.push(label.new(bar_index + 15, lo, "SSL", style = label.style_label_left,
                         color = color.new(color.black, 100), textcolor = color.aqua, size = size.tiny))
                if hi > close
                    lqLines.push(line.new(bar_index - 5, hi, bar_index + 15, hi, color = color.fuchsia, style = line.style_dotted))
                    lqLabels.push(label.new(bar_index + 15, hi, "BSL", style = label.style_label_left,
                         color = color.new(color.black, 100), textcolor = color.fuchsia, size = size.tiny))
if barstate.islast and showZones
    for b in zBoxes
        b.delete()
    zBoxes.clear()
    if zLow.size() > 0
        for i = 0 to zLow.size() - 1
            if zTouch.get(i) >= minTouches
                col = zKind.get(i) == 1 ? color.red : zKind.get(i) == 2 ? color.green : color.blue
                zBoxes.push(box.new(zLast.get(i), zHigh.get(i), time, zLow.get(i), xloc = xloc.bar_time,
                     extend = extend.right, border_color = color.new(col, 40), bgcolor = color.new(col, 85),
                     text = str.tostring(zTouch.get(i)) + "x", text_size = size.tiny, text_color = col))
