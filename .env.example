# Copier en .env (ignoré par git) et remplacer les valeurs. Ne jamais commiter .env.

# Base PostgreSQL (docker-compose.yml + application)
SRLIQ_DB_URL=jdbc:postgresql://localhost:5432/srliq
SRLIQ_DB_USER=srliq
SRLIQ_DB_PASSWORD=change-me

# Secret de l'URL du webhook TradingView (>= 16 caractères, aléatoire), par ex. : openssl rand -hex 24
# URL à saisir dans l'alerte TradingView : https://<hôte>/api/webhooks/tradingview/<secret>
# Vide : webhook désactivé (503).
SRLIQ_WEBHOOK_TOKEN=

# Notifications Telegram (facultatif). Jeton donné par @BotFather, identifiant de la discussion.
# Vides : notifications désactivées.
SRLIQ_TELEGRAM_BOT_TOKEN=
SRLIQ_TELEGRAM_CHAT_ID=

# Base des tests (facultatif ; défaut jdbc:postgresql://localhost:5432/srliq_test, srliq/srliq)
# SRLIQ_TEST_DB_URL=jdbc:postgresql://localhost:5432/srliq_test
